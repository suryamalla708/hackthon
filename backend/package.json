{
  "name": "repair-ai-backend",
  "version": "1.0.0",
  "description": "Intentionally broken Express API for RepairAI (PS-04)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --forceExit --detectOpenHandles --verbose",
    "test:ci": "jest --forceExit --detectOpenHandles --verbose --json --outputFile=test-results.json",
    "collect": "node scripts/collectFailures.js",
    "collect:view": "node scripts/collectFailures.js && node -e \"const r=require('./logs/failure-report.json');console.log(JSON.stringify(r.summary,null,2));\"",
    "search": "node scripts/searchCode.js",
    "pipeline": "npm run collect && npm run search",
    "repair": "node scripts/repair.js",
    "revert": "node scripts/repair.js --revert",
    "agent": "node scripts/agent.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/genai": "^2.16.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "supertest": "^7.0.0"
  }
}
